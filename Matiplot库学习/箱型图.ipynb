   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "np.random.seed(100)\n",
    "data = np.random.normal(size=(1000,4),loc=0,scale=1)\n",
    "\n",
    "plt.boxplot(data,sym='bo',patch_artist=True,whis=1.5)\n",
    "\n",
    "plt.show()"
   ]
