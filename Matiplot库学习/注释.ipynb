    "import numpy as np \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x=np.arange(-10,11,1)\n",
    "\n",
    "y=x*x\n",
    "\n",
    "plt.plot(x,y)\n",
    "\n",
    "plt.annotate('This is the bottom',xy=(0,1),xytext=(0,20),arrowprops=dict(facecolor='r'))\n",
    "\n",
    "plt.show()\n"
   ]
