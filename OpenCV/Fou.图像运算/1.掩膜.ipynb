    "import cv2\n",
    "import numpy as np\n",
    "\n",
    "mask= np.zeros([150,150,3],np.uint8)\n",
    "mask[50:100, 20:80, :] = 255\n",
    "cv2.imshow(\"mask1\",mask)\n",
    "mask[:,:,:]=255\n",
    "mask[50:100, 20:80, :] = 0\n",
    "cv2.imshow('mask2',mask)\n",
    "cv2.waitKey()\n",
    "cv2.destroyAllWindows()"
   ]
